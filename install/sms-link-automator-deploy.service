[Unit]
Description=Build and publish SMS Link Automator APK into Hub 2 APK Library
After=network-online.target
Wants=network-online.target
ConditionHost=archimedes

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/Projects/sms_forwarder
EnvironmentFile=-%h/.config/sms-forwarder/deploy.env
ExecStart=/home/ubuntu/Projects/sms_forwarder/scripts/deploy_linkautomator.sh
TimeoutStartSec=20min
Nice=10
